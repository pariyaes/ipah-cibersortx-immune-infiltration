# R session and project files
.Rhistory
.RData
.Ruserdata
.Rproj.user/
*.Rproj

# Operating-system files
.DS_Store
Thumbs.db

# Private or large source data
data/raw/
data/private/

# Temporary files
*.tmp
*.log
~$*

# Keep validated result tables
results/*
!results/.gitkeep
!results/*.tsv
!results/sessionInfo.txt

# Keep generated figures
figures/*
!figures/.gitkeep
!figures/*.png

# Preserve exact corrected project outputs
!results/original_project_outputs/
!results/original_project_outputs/**

!figures/original_project_figures/
!figures/original_project_figures/**
